const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");

const BASE_URL = "https://downloader.nkx.lol";

function extractYoutubeResults(payload) {
  const nested = payload?.results || payload?.data?.results || payload?.data?.items || payload?.data || [];
  if (Array.isArray(nested)) return nested;
  if (Array.isArray(payload?.items)) return payload.items;
  return [];
}

module.exports = {
  config: {
    name: "ytb",
    version: "2.1",
    author: "Neoaz 🐊",
    countDown: 5,
    role: 0,
    shortDescription: { en: "YouTube downloader" },
    category: "media",
    guide: { en: "{pn} -a <query> or {pn} -v <query>" }
  },

  onStart: async function ({ message, args, event, api, commandName }) {
    const type = args[0];
    const query = args.slice(1).join(" ");

    if (!["-a", "-v"].includes(type) || !query) {
      return message.reply(`Usage: ${this.config.name} -a <query> or -v <query>`);
    }

    try {
      const searchCandidates = [
        `${BASE_URL}/api/search/youtube`,
        `${BASE_URL}/api/youtube/search`
      ];

      let results = [];
      for (const url of searchCandidates) {
        try {
          const res = await axios.get(url, {
            params: { q: query, limit: 6 },
            timeout: 30000,
            validateStatus: () => true
          });
          results = extractYoutubeResults(res.data);
          if (results.length > 0) break;
        } catch {}
      }

      if (results.length === 0) {
        return message.reply("No results found.");
      }

      let msg = "";
      const attachments = [];
      const cacheDir = path.join(__dirname, "cache");
      await fs.ensureDir(cacheDir);

      for (let i = 0; i < results.length; i++) {
        const item = results[i];
        const title = item.title || item.name || `Result ${i + 1}`;
        const duration = item.duration?.timestamp || item.duration || item.timestamp || "unknown";
        const thumbnail = item.thumbnail || item.thumbnail_url || item.image || item.img || item.cover;

        msg += `${i + 1}. ${title}\n[${duration}]\n\n`;

        if (thumbnail) {
          try {
            const imgPath = path.join(cacheDir, `yt_${Date.now()}_${i}.jpg`);
            const imgRes = await axios.get(thumbnail, { responseType: "arraybuffer", timeout: 20000 });
            await fs.writeFile(imgPath, Buffer.from(imgRes.data));
            attachments.push(fs.createReadStream(imgPath));
          } catch {}
        }
      }

      message.reply({ body: msg.trim(), attachment: attachments }, (err, info) => {
        if (!info?.messageID) return;
        global.GoatBot.onReply.set(info.messageID, {
          commandName,
          author: event.senderID,
          results,
          downloadType: type === "-a" ? "audio" : "video"
        });
        attachments.forEach(s => setTimeout(() => fs.remove(s.path).catch(() => {}), 10000));
      });
    } catch (e) {
      message.reply("Search error.");
    }
  },

  onReply: async function ({ message, event, Reply, api }) {
    const choice = parseInt(event.body);
    if (isNaN(choice) || choice < 1 || choice > Reply.results.length) return;

    const selected = Reply.results[choice - 1];
    const selectedUrl = selected.url || selected.link || selected.video_url || selected.download_url;
    if (!selectedUrl) {
      return message.reply("This result does not contain a valid download link.");
    }

    api.unsendMessage(event.messageReply.messageID);
    api.setMessageReaction("⏳", event.messageID);

    try {
      const dlRes = await axios.get(`${BASE_URL}/api/download/youtube`, {
        params: { url: selectedUrl },
        validateStatus: () => true,
        timeout: 30000
      });

      if (!dlRes.data?.success) {
        api.setMessageReaction("❌", event.messageID);
        return message.reply(dlRes.data?.message || "Download error.");
      }

      const info = dlRes.data.data || {};
      const streamUrl = Reply.downloadType === "audio"
        ? (info.mp3 || info.audio || info.url || info.download_url)
        : (info.mp4 || info.video || info.url || info.download_url);

      if (!streamUrl) {
        api.setMessageReaction("❌", event.messageID);
        return message.reply("Unable to retrieve download link.");
      }

      const cacheDir = path.join(__dirname, "cache");
      await fs.ensureDir(cacheDir);
      const ext = Reply.downloadType === "audio" ? "mp3" : "mp4";
      const filePath = path.join(cacheDir, `${Date.now()}.${ext}`);

      const fileRes = await axios.get(streamUrl, { responseType: "arraybuffer", timeout: 45000 });
      await fs.writeFile(filePath, Buffer.from(fileRes.data));

      await message.reply({
        body: info.title || selected.title || selected.name || "YouTube media",
        attachment: fs.createReadStream(filePath)
      });

      api.setMessageReaction("✅", event.messageID);
      fs.remove(filePath).catch(() => {});
    } catch (e) {
      api.setMessageReaction("❌", event.messageID);
      message.reply("Download error.");
    }
  }
};

